# Domínio final, sem barra no fim. Usado no canonical, no sitemap e no JSON-LD.
# Opcional: sem ela, vale https://www.clinicaodontocasais.com.br (definido em src/lib/site.ts).
NEXT_PUBLIC_SITE_URL=https://www.clinicaodontocasais.com.br

# Opcional: código da meta tag de verificação do Google Search Console.
GOOGLE_SITE_VERIFICATION=

GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Chave separada e restrita por domínio (HTTP referrer), com apenas a
# "Maps Embed API" habilitada. É exposta no HTML do site, então NÃO reutilize
# a GOOGLE_PLACES_API_KEY acima aqui.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
